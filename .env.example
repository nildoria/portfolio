# Site URL used for OG/Twitter metadata. Falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Google Tag Manager container ID. Omit to disable analytics.
NEXT_PUBLIC_GTM=

# Contact form -> Telegram. Both required for the form to deliver.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# reCAPTCHA server-side verification. NOT NEXT_PUBLIC_ — this is a secret and
# must never be inlined into the client bundle.
RECAPTCHA_SECRET_KEY=
